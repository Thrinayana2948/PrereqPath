# Copy to backend/.env (never commit .env). Placeholders only.
# Supabase dashboard -> Connect -> "Session pooler" (port 5432). Copy the URI, replace [YOUR-PASSWORD],
# and URL-encode special characters in the password (e.g. @ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: run database integration tests in an isolated, auto-dropped schema
# TEST_DATABASE_URL=postgresql://...
